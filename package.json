    "pixi.js": "^8.14.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.18.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.4"
  },
  "license": "MIT",
